# Secretos del monitor DFT.
#
# Copia este fichero a `.env` y rellena lo que uses. El `.env` está
# gitignorado: nunca se comitea ni viaja dentro de los binarios publicados.
#
#   cp .env.example .env
#
# Se busca, en este orden:
#   1. la ruta que indique DFT_ENV_FILE
#   2. junto a monitor.yaml (~/.config/dft-monitor/.env)
#   3. la raíz de datos (DFT_DATA_ROOT)
#   4. el directorio actual
#
# Las variables que ya estén en el entorno mandan sobre este fichero.

# Token compartido de la interfaz web. Ponerlo activa la autenticación;
# dejarlo vacío la desactiva, que solo es razonable escuchando en 127.0.0.1.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DFT_MONITOR_TOKEN=

# Firma de las cookies de sesión. Si se deja vacío se genera uno al arrancar,
# lo que cierra la sesión de todos cada vez que se reinicia el servidor.
DFT_MONITOR_SESSION_SECRET=

# Notificaciones por Telegram. Vacío desactiva el bot, no es un error.
# El token lo da @BotFather.
DFT_MONITOR_TELEGRAM_BOT_TOKEN=
DFT_MONITOR_TELEGRAM_CHAT_ID=
